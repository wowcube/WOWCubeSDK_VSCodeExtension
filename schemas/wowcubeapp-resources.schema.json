{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WOWCube Resource Bundle",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceFolders",
    "resources",
    "registries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "sourceFolders": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*[\\\\:])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?!.*//)(?!.*\\/$).+$"
          },
          {
            "const": "."
          }
        ]
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9_]{1,23}$",
            "maxLength": 23,
            "not": {
              "enum": [
                "zero",
                "0",
                "pal",
                "bmp_none",
                "bmp_last",
                "bmp_0",
                "map_none",
                "map_last"
              ]
            }
          },
          "type": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": { "const": "sprite" }
              }
            },
            "else": {
              "properties": {
                "name": { "not": { "const": "icon" } }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "palette"
                }
              }
            },
            "then": {
              "required": [
                "colors",
                "transparentIndex",
                "mappingColors",
                "colorCount"
              ],
              "properties": {
                "colors": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 256,
                  "items": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                  },
                  "allOf": [
                    {
                      "items": [
                        {
                          "const": "#00000000"
                        }
                      ]
                    }
                  ],
                  "description": "Current display colors. Entry zero is always #00000000."
                },
                "mappingColors": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 256,
                  "description": "Generated matching colors. Entry zero is always #00000000.",
                  "items": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                  },
                  "allOf": [
                    {
                      "items": [
                        {
                          "const": "#00000000"
                        }
                      ]
                    }
                  ]
                },
                "colorCount": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 256
                },
                "transparentIndex": {
                  "const": 0,
                  "description": "Always 0: the device reserves entry zero for transparency."
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "sprite"
                }
              }
            },
            "then": {
              "required": [
                "source",
                "paletteId",
                "pivot",
                "collider",
                "colorMode",
                "blend",
                "fullsize",
                "dither",
                "compression",
                "number",
                "frameRate",
                "group",
                "objectType",
                "tags"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*[\\\\:])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?!.*//)(?!.*\\/$).+$"
                },
                "paletteId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "pivot": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "description": "Authored source pixels; null means image center.",
                  "required": [
                    "x",
                    "y"
                  ],
                  "properties": {
                    "x": {
                      "type": "number",
                      "multipleOf": 0.5
                    },
                    "y": {
                      "type": "number",
                      "multipleOf": 0.5
                    }
                  }
                },
                "collider": {
                  "type": "object",
                  "required": [
                    "enabled",
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "x": {
                      "type": "number",
                      "minimum": 0
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0
                    },
                    "width": {
                      "type": "number",
                      "minimum": 0
                    },
                    "height": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                },
                "colorMode": {
                  "type": "string",
                  "enum": [
                    "palette",
                    "rgb565",
                    "rgb6666"
                  ],
                  "description": "RGB6666 is a hidden, unsupported placeholder."
                },
                "blend": {
                  "type": "string",
                  "enum": [
                    "opaque",
                    "alpha",
                    "additive",
                    "bg",
                    "bump",
                    "dudv",
                    "refl"
                  ],
                  "description": "BUMP, DUDV and REFL are preserved stubs; BG is advanced."
                },
                "fullsize": {
                  "type": "boolean",
                  "default": false
                },
                "dither": {
                  "type": "boolean",
                  "default": false
                },
                "compression": {
                  "enum": [
                    "plain",
                    "softkey",
                    null
                  ]
                },
                "number": {
                  "type": "integer",
                  "minimum": -32768,
                  "maximum": 32767,
                  "default": 0
                },
                "frameRate": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 127,
                  "default": 1,
                  "description": "Engine hold counter. Animation duration at multiplier 1 is (frameRate + 1) \u00d7 50 ms. Static sprites retain the default 1."
                },
                "group": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "objectType": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Sprite classification; type identifies the resource kind."
                },
                "tags": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "softkey": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "required": [
                    "key",
                    "threshold"
                  ],
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "threshold": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    }
                  }
                },
                "sequence": {
                  "type": "object",
                  "required": [
                    "id",
                    "name",
                    "index"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z0-9_]+$",
                      "maxLength": 23
                    },
                    "index": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "description": "At least two sprite records must share the sequence ID, with contiguous indices from zero. Names reserve both BMP_<name> and BMP_<name>_end."
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "colorMode": {
                        "const": "rgb565"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "paletteId": {
                        "type": "null"
                      },
                      "blend": {
                        "const": "opaque"
                      },
                      "compression": {
                        "enum": [
                          "plain",
                          "softkey"
                        ]
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "colorMode": {
                        "const": "palette"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "paletteId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "dither": {
                        "const": false
                      },
                      "compression": {
                        "type": "null"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "compression": {
                        "const": "softkey"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "softkey"
                    ],
                    "properties": {
                      "softkey": {
                        "type": "object"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "softkey": {
                        "type": "null"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "not": {
                      "required": [
                        "sequence"
                      ]
                    }
                  },
                  "then": {
                    "properties": {
                      "frameRate": {
                        "minimum": 1
                      }
                    }
                  }
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "map"
                }
              }
            },
            "then": {
              "required": [
                "placements",
                "sideMarkers",
                "net"
              ],
              "properties": {
                "placements": {
                  "type": "array",
                  "description": "Topmost first; each item is a separate instance referencing a sprite resource.",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "spriteId",
                      "side",
                      "x",
                      "y"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "spriteId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "twistable": {
                        "type": "boolean",
                        "default": false,
                        "description": "Whether this sprite instance moves with cube twists."
                      },
                      "side": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    }
                  }
                },
                "sideMarkers": {
                  "type": "array",
                  "minItems": 6,
                  "maxItems": 6,
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "side",
                      "x",
                      "y"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^~side[0-5]$"
                      },
                      "side": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "x": {
                        "const": 0
                      },
                      "y": {
                        "const": 0
                      }
                    }
                  }
                },
                "net": {
                  "type": "object",
                  "required": [
                    "screenSize",
                    "innerGap",
                    "faceEdgeGap",
                    "frame",
                    "padding",
                    "lineColor",
                    "background",
                    "markerColor",
                    "markers",
                    "backgroundImage"
                  ],
                  "properties": {
                    "screenSize": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "innerGap": {
                      "type": "integer",
                      "minimum": 0,
                      "multipleOf": 2
                    },
                    "faceEdgeGap": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "frame": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "padding": {
                      "type": "object",
                      "required": [
                        "right",
                        "bottom"
                      ],
                      "properties": {
                        "right": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "bottom": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "lineColor": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                    },
                    "background": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "markerColor": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                    },
                    "markers": {
                      "type": "boolean"
                    },
                    "backgroundImage": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string",
                          "pattern": "^(?!/)(?!.*[\\\\:])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?!.*//)(?!.*\\/$).+$"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "font"
                }
              }
            },
            "then": {
              "required": [
                "source",
                "atlas",
                "slot",
                "paletteId",
                "fullsize",
                "blend"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*[\\\\:])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?!.*//)(?!.*\\/$).+$",
                  "description": "Binary BMFont v3 file, relative to the project."
                },
                "atlas": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*[\\\\:])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?!.*//)(?!.*\\/$).+$",
                  "description": "PNG page resolved from the .fnt reference, or explicitly overridden."
                },
                "slot": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                },
                "paletteId": {
                  "type": "string",
                  "minLength": 1
                },
                "fullsize": {
                  "type": "boolean"
                },
                "blend": {
                  "const": "alpha"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "sound"
                }
              }
            },
            "then": {
              "required": [
                "source"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "description": "Source WAV or MP3, relative to the folder containing the resource JSON. Audio properties and preview data are computed, not stored."
                }
              }
            }
          }
        ]
      }
    },
    "registries": {
      "type": "object",
      "required": [
        "groups",
        "types",
        "tags"
      ],
      "properties": {
        "groups": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 255,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "types": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 255,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
